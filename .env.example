# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CLAUDE_API_KEY: Optional. Used if you want to generate scripts with Anthropic's Claude.
# Set this in your Secrets panel or .env file to enable Claude.
CLAUDE_API_KEY=""

# ELEVENLABS_API_KEY: Optional but recommended. When set, narration voice-overs are generated
# via ElevenLabs (eleven_multilingual_v2) instead of Gemini TTS — better French narration quality,
# and avoids depending on Gemini's audio quota/billing.
ELEVENLABS_API_KEY=""

# CLIP_CAFE_API_KEY: Recommended. Your official Clip.Cafe PRO API key (get one at https://clip.cafe/pro,
# then see https://clip.cafe/api-docs/). This is Clip.Cafe's own structured search API — NOT a Scrapestack key.
# Without it, clip search falls back to the small local stock-footage catalog only.
CLIP_CAFE_API_KEY=""

# YAPPER_API_KEY: Requis pour le mode "Vox Doc Engine". Clé d'API de votre équipe Yapper
# (https://yapper.so), utilisée pour générer les images de chaque beat et les clips animés.
# Chaque génération dépense de vrais crédits d'équipe : l'interface chiffre toujours le coût
# en dryRun (gratuit) et demande une validation avant de lancer un lot.
# Sans cette clé, les états 1 à 7 et 9 du moteur fonctionnent (script, beats, prompts,
# fichier .txt, vignettes) mais aucune image ni vidéo n'est produite.
YAPPER_API_KEY=""

# YAPPER_API_URL: Optionnel. Racine de l'API Yapper, par défaut https://yapper.so/api/v1
YAPPER_API_URL=""

# YAPPER_AUTH_HEADER: Optionnel. Nom de l'en-tête d'authentification, "Authorization" par défaut
# (envoyé en "Bearer <clé>"). À changer uniquement si Yapper fait évoluer son schéma d'auth.
YAPPER_AUTH_HEADER=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
