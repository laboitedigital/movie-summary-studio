# À placer dans /etc/nginx/sites-available/movie-summary-studio
# puis : sudo ln -s /etc/nginx/sites-available/movie-summary-studio /etc/nginx/sites-enabled/
#
# Remplace "video.tondomaine.com" par ton vrai sous-domaine.

server {
    listen 80;
    server_name video.tondomaine.com;

    # Important : les payloads contiennent des audios TTS encodés en base64
    # (peuvent atteindre plusieurs Mo par segment). La limite par défaut de Nginx est 1M.
    client_max_body_size 60M;

    # Les requêtes de rendu réel sont rapides (le rendu tourne en tâche de fond,
    # le frontend "poll" /api/render/status). En revanche, la génération de script
    # (surtout pour des scripts longs de 10-20 min, avec réessai automatique en cas
    # de JSON invalide) peut prendre jusqu'à 1-2 minutes — on prévoit une marge large.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
